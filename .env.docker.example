# ==============================================================================
# Docker Environment Configuration Template
# CAKAP FT MAOS — PT Pertamina Patra Niaga Fuel Terminal Maos
# Copy to .env when running via Docker Compose: cp .env.docker.example .env
# ==============================================================================

APP_NAME="CAKAP FT MAOS"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8080
APP_PORT=8080

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_TIMEZONE=Asia/Jakarta

# Database Configuration (Docker MySQL Service)
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=cakapftmaos
DB_USERNAME=cakap_user
DB_PASSWORD=cakap_secret_123
DB_ROOT_PASSWORD=root_secret_pertamina

# Redis Service
CACHE_STORE=redis
SESSION_DRIVER=redis
QUEUE_CONNECTION=redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null

# Filesystem
FILESYSTEM_DISK=public

# Mail / SMTP Configuration
MAIL_MAILER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="no-reply@cakap-pertamina.com"
MAIL_FROM_NAME="CAKAP FT MAOS - HSSE"

# JWT Authentication
JWT_SECRET=

# Container Automation Flags
AUTO_MIGRATE=true
CACHE_ON_STARTUP=true
