# ==============================================================================
# Kamal Secrets Configuration Template for CAKAP FT MAOS
# ==============================================================================
# Salin file ini menjadi .kamal/secrets lalu isi dengan kredensial produksi Anda.
# File .kamal/secrets SUDAH otomatis di-ignore oleh Git agar aman.

# 0. IP Publik Server VPS (Disembunyikan dari file git)
SERVER_IP="103.xxx.xxx.xxx"

# 1. Kredensial Registry Docker (Personal Access Token / Docker Hub Token)
KAMAL_REGISTRY_PASSWORD="your-docker-hub-token-or-ghcr-token"

# 2. Kunci Enkripsi Laravel (Didapat dari php artisan key:generate --show)
APP_KEY="base64:xxxx..."

# 3. Kredensial Database MySQL
DB_PASSWORD="your-production-db-password"
DB_ROOT_PASSWORD="your-production-root-password"
MYSQL_PASSWORD="your-production-db-password"
MYSQL_ROOT_PASSWORD="your-production-root-password"

# 4. Kredensial JWT Auth & Mailer
JWT_SECRET="your-jwt-secret-key"
MAIL_PASSWORD="your-email-app-password"
